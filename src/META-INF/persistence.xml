<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
	xmlns="https://jakarta.ee/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
		https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

	<!-- Nom utilisé par Persistence.createEntityManagerFactory("GestionSeries") -->
	<persistence-unit name="GestionSeries" transaction-type="RESOURCE_LOCAL">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

		<!-- Les entités seront déclarées explicitement (pages 50+) -->
		<exclude-unlisted-classes>true</exclude-unlisted-classes>

		<properties>
			<!-- Connexion JDBC MySQL (WAMP) -->
			<property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
			<property name="jakarta.persistence.jdbc.url"
				value="jdbc:mysql://localhost:3306/GestionSeries?serverTimezone=UTC&amp;useSSL=false&amp;allowPublicKeyRetrieval=true" />
			<property name="jakarta.persistence.jdbc.user" value="root" />
			<!-- Mot de passe WAMP souvent vide ; adapter si besoin -->
			<property name="jakarta.persistence.jdbc.password" value="" />

			<!-- FINE = traces détaillées en dev ; passer à INFO en prod (PDF p.37) -->
			<property name="eclipselink.logging.level" value="FINE" />
			<property name="eclipselink.logging.level.sql" value="FINE" />
		</properties>
	</persistence-unit>
</persistence>
